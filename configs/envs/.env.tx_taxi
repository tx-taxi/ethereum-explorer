# tx.taxi Ethereum explorer preset
# Production host: https://eth.tx.taxi
#
# APP_* values are intentionally omitted because the upstream entrypoint does not
# import them from presets. Supply those runtime values in Coolify as documented
# in docs/TX_TAXI_DEPLOY.md.

NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_HOST=eth.blockscout.com
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss

NEXT_PUBLIC_NETWORK_NAME=Ethereum
NEXT_PUBLIC_NETWORK_SHORT_NAME=Ethereum
NEXT_PUBLIC_NETWORK_ID=1
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Ether
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=ETH
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_IS_TESTNET=false

NEXT_PUBLIC_NETWORK_LOGO=https://raw.githubusercontent.com/tx-taxi/ethereum-explorer/tx-taxi/public/static/tx-taxi/logo.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=https://raw.githubusercontent.com/tx-taxi/ethereum-explorer/tx-taxi/public/static/tx-taxi/logo-dark.svg
NEXT_PUBLIC_NETWORK_ICON=https://raw.githubusercontent.com/tx-taxi/ethereum-explorer/tx-taxi/public/static/tx-taxi/icon.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=https://raw.githubusercontent.com/tx-taxi/ethereum-explorer/tx-taxi/public/static/tx-taxi/icon-dark.svg

NEXT_PUBLIC_FEATURED_NETWORKS=[{'title':'Bitcoin','url':'https://btc.tx.taxi','group':'Mainnets'},{'title':'Monero','url':'https://xmr.tx.taxi','group':'Mainnets'},{'title':'Ethereum','url':'https://eth.tx.taxi','group':'Mainnets','isActive':true}]
NEXT_PUBLIC_FEATURED_NETWORKS_MODE=list
NEXT_PUBLIC_FOOTER_LINKS=[{'title':'tx.taxi','links':[{'text':'Bitcoin explorer','url':'https://btc.tx.taxi'},{'text':'Monero explorer','url':'https://xmr.tx.taxi'},{'text':'Ethereum explorer','url':'https://eth.tx.taxi'},{'text':'Source code','url':'https://github.com/tx-taxi/ethereum-explorer'}]}]

NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs','coin_price','market_cap']
NEXT_PUBLIC_HOMEPAGE_STATS=['total_blocks','average_block_time','total_txs','wallet_addresses','gas_tracker']
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false
NEXT_PUBLIC_OG_DESCRIPTION=Explore Ethereum blocks, transactions, addresses, tokens, and verified contracts on tx.taxi.
NEXT_PUBLIC_OG_ENHANCED_DATA_ENABLED=true
NEXT_PUBLIC_COLOR_THEME_DEFAULT=dark

# Keep read-only explorer functionality and contract verification views. Avoid
# account, wallet-writing, marketplace, ad, and analytics integrations.
NEXT_PUBLIC_IS_ACCOUNT_SUPPORTED=false
NEXT_PUBLIC_WEB3_WALLETS=none
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none
NEXT_PUBLIC_HAS_BEACON_CHAIN=true
NEXT_PUBLIC_DATA_AVAILABILITY_ENABLED=true
NEXT_PUBLIC_HIDE_INDEXING_ALERT_BLOCKS=true
